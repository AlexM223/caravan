# Caravan coordinator app is platform agnostic, the build platform output can be reused.
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS base

# Install all OS dependencies
FROM base AS builder
ENV DEBIAN_FRONTEND noninteractive
RUN apt-get update --yes && \
    apt-get upgrade --yes && \
    apt-get install --yes --no-install-recommends \
    build-essential

# Set the working directory
WORKDIR /app
RUN npm install -g turbo
COPY . .
# Optimize caching with docker
# https://turbo.build/repo/docs/handbook/deploying-with-docker
RUN turbo prune caravan-coordinator --docker

# Add lockfile and package.json's of isolated subworkspace
FROM base AS installer
WORKDIR /app

# First install the dependencies (as they change less often)
COPY --from=builder /app/out/json/ .
# Copy the scripts directory that contains check-node-versions.js
COPY --from=builder /app/scripts ./scripts
RUN npm ci

# Build the project
COPY --from=builder /app/out/full/ .
ENV NODE_OPTIONS=--max-old-space-size=32768

RUN npx turbo run build --filter=caravan-coordinator...

# Umbrel runner: serve the static build via nginx and generate a same-origin
# reverse proxy to the Umbrel Bitcoin node's RPC at container start.
FROM nginx:1.27-alpine AS runner
COPY --from=installer /app/apps/coordinator/build /usr/share/nginx/html/
COPY apps/coordinator/umbrel/40-bitcoind-proxy.sh /docker-entrypoint.d/40-bitcoind-proxy.sh
COPY apps/coordinator/umbrel/41-umbrel-config.sh /docker-entrypoint.d/41-umbrel-config.sh
RUN chmod +x /docker-entrypoint.d/40-bitcoind-proxy.sh /docker-entrypoint.d/41-umbrel-config.sh
